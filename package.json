{
  "name": "athlyrax-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-index-signup-legal.mjs && node scripts/patch-logout-csrf.mjs && node scripts/patch-tenant-storage-path.mjs",
    "start": "npm run test:signup-legal-acceptance && npm run test:storage-path-contract && node scripts/safe-start.mjs",
    "start:unsafe": "node index.js",
    "check:storage-safety": "node scripts/check-storage-safety.mjs",
    "test:storage-safety": "node --test tests/storage-safety.test.mjs",
    "test:storage-path-contract": "node --test tests/storage-path-contract.test.mjs",
    "test:signup-legal-acceptance": "node --test tests/signup-legal-acceptance.test.mjs",
    "verify:closed-pilot-security": "node verify-closed-pilot-security.mjs && npm run test:signup-legal-acceptance && npm run test:storage-path-contract",
    "test:closed-pilot-security": "node --test tests/closed-pilot-security.integration.test.mjs",
    "test:closed-pilot-backup-restore": "node --test tests/closed-pilot-backup-restore.test.mjs",
    "stage:storage-restore": "node scripts/stage-storage-restore.mjs",
    "approve:storage-layout": "node scripts/approve-storage-layout.mjs",
    "smoke:prod": "node scripts/prod-isolation-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.5",
    "stripe": "^16.12.0"
  }
}
